# Server-only Gemini secret. Never expose this as VITE_GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER=gemini

# Server-side database/auth provider.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe Supabase Auth config. These are publishable values, not secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public app URL used by password-reset redirects.
APP_URL=

# Feature flags
ENABLE_AI_MEMORY=true
ENABLE_SPEAKING_AI=true

# Optional observability / deployment metadata
VERCEL_ANALYTICS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
