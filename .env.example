# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# Gemini Model configuration (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# AI Provider: 'gemini' for real API or 'mock' for local simulation fallback
AI_PROVIDER=gemini

# Feature Flags
ENABLE_AI_MEMORY=true
ENABLE_SPEAKING_AI=true

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Supabase Cloud Database & Authentication (Optional, falls back to Mock/Guest mode if empty)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_MOCK_AUTH=false
